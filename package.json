{
  "name": "carebridge-portal",
  "version": "1.4.0",
  "private": true,
  "description": "Clinician operations console for care coordination teams",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.850.0",
    "@aws-sdk/client-s3": "^3.850.0",
    "@aws-sdk/s3-request-presigner": "^3.850.0",
    "@prisma/client": "6.11.1",
    "bcryptjs": "3.0.2",
    "jose": "6.0.10",
    "next": "15.3.2",
    "pino": "9.10.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.0",
    "@tailwindcss/postcss": "4.1.3",
    "@types/node": "22.15.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "eslint": "9.25.1",
    "eslint-config-next": "15.3.2",
    "prettier": "3.5.3",
    "prisma": "6.11.1",
    "tailwindcss": "4.1.3",
    "tsx": "4.20.0",
    "typescript": "5.8.3",
    "vitest": "3.1.2"
  }
}
